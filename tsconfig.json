{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "rootDir": "./",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@forge/*": ["forge/*"]
    }
  },
  "include": ["src/**/*", "forge/**/*", "server.ts", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
